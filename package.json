{
  "name": "apex-tv",
  "version": "0.5.11",
  "private": true,
  "description": "Independent open-source F1 TV client for Samsung Tizen TVs",
  "main": "companion/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "prepare-tv": "node tools/build-tv.mjs",
    "build:tv": "node tools/build-tv.mjs && node tools/check-legacy.mjs",
    "check:public": "node tools/check-public.mjs",
    "check:legacy": "node tools/check-legacy.mjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "electron": "44.7.0",
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pajuodelis/apex-tv.git"
  },
  "browserslist": [
    "chrome 63"
  ]
}
